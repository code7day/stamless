APP_NAME=Stamless
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://stamless.host
APP_URL_API=https://api.stamless.host
APP_URL_GRAPHQL=https://graphql.stamless.host
APP_URL_STUDIO=https://studio.stamless.host
APP_URL_PLATFORM=https://platform.stamless.host
SANCTUM_STATEFUL_DOMAINS=stamless.host,studio.stamless.host,platform.stamless.host

# Botón "Mejorar plan" del Escritorio (Studio) — mailto: hacia este correo
# hasta que exista self-serve billing (fuera de alcance del MVP).
STAMLESS_SALES_EMAIL=hola@stamless.host

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=genesis_cms
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=genesis

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Session domain (compartir sesión entre platform.*, studio.* y app.*)
SESSION_DOMAIN=.stamless.host
SESSION_COOKIE=stamless_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# CLOUDFLARE R2 / S3 STORAGE (Producción: FILESYSTEM_DISK=r2)
# ==============================================================================
# FILESYSTEM_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=genesis-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_URL=https://pub-<hash>.r2.dev
R2_USE_PATH_STYLE_ENDPOINT=false

# AWS S3 (Opcional / alternativo)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OAuth Providers (Social Login)
# Usar rutas relativas ("/oauth/callback/...") para que resuelvan automáticamente
# al subdominio desde donde se originó el login (Studio o Platform).
# Registrar ambas URIs en Google Cloud Console / proveedores:
#  - https://studio.stamless.host/oauth/callback/google
#  - https://platform.stamless.host/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="/oauth/callback/google"

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL="/oauth/callback/linkedin-openid"

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URL="/oauth/callback/twitter-oauth-2"

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URL="/oauth/callback/instagram"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL="/oauth/callback/facebook"

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URL="/oauth/callback/microsoft"

# ==============================================================================
# CONFIGURACIÓN DE IMPLEMENTACIÓN DE INFRAESTRUCTURA - STAMLESS
# ==============================================================================
STAMLESS_DEPLOY_SERVER="server-webapps"
STAMLESS_DEPLOY_DOMAIN="stamless.com"
STAMLESS_DEPLOY_SUBDOMAIN=false
# STAMLESS_DEPLOY_RUN_HORIZON=false
# STAMLESS_DEPLOY_RUN_REVERB=false



